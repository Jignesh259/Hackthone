# ==============================================================================
# ScamShield Frontend Environment Variables (.env.example)
# Rename or copy this file to `.env` in the scamdelection directory
# All API URLs and backend endpoints are dynamically stored here
# ==============================================================================

# API Base URL for connecting to the FastAPI backend
# Default for local development:
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# When using an ngrok tunnel, point to your public ngrok URL:
# VITE_API_URL=https://your-tunnel-subdomain.ngrok-free.app

# API Endpoints
VITE_API_HEALTH_PATH=/health
VITE_API_ANALYZE_PATH=/api/analyze
VITE_API_EXAMPLES_PATH=/api/examples
VITE_API_STATS_PATH=/api/stats
VITE_API_RULES_PATH=/api/rules
